{
  "name": "freewebstuff",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"const fs=require('fs'); if(fs.existsSync('.next/BUILD_ID')){console.log('Cleaning production build cache for dev server...'); fs.rmSync('.next',{recursive:true,force:true})}\"",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "check:sites": "node scripts/daily-health-check.mjs",
    "check:sites:update": "node scripts/daily-health-check.mjs --update-sources",
    "vault:sync": "node scripts/auto-sync-and-prune.mjs --sync",
    "vault:prune": "node scripts/auto-sync-and-prune.mjs --prune",
    "vault:all": "node scripts/auto-sync-and-prune.mjs --all",
    "cf:purge": "node scripts/purge-cloudflare.mjs"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "fuse.js": "^7.0.0",
    "lucide-react": "^0.468.0",
    "next": "^14.2.20",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
